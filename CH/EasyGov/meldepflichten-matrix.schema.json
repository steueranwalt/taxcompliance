{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/steueranwalt/taxcompliance/CH/EasyGov/meldepflichten-matrix.schema.json",
  "title": "Meldepflichten-Matrix EasyGov",
  "type": "object",
  "required": ["schema_version", "stand", "hinweis", "zeilen"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "stand": { "type": "string", "format": "date" },
    "hinweis": { "type": "string" },
    "schwelle_umsatz_chf": { "type": "integer" },
    "zeilen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "rechtsform", "umsatz", "personal", "hr", "mwst", "ahv", "uvg"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "rechtsform": { "type": "string", "enum": ["EU", "GmbH", "AG", "KlG", "KmG"] },
          "umsatz": { "type": "string", "enum": ["unter_100k", "ab_100k"] },
          "personal": { "type": "string", "enum": ["nur_inhaber", "mit_angestellten"] },
          "hr": { "type": "string", "enum": ["zwingend", "freiwillig", "nach_hr_eintrag"] },
          "mwst": { "type": "string", "enum": ["zwingend", "freiwillig", "nach_hr_eintrag"] },
          "ahv": { "type": "string", "enum": ["zwingend", "freiwillig", "nach_hr_eintrag"] },
          "uvg": { "type": "string", "enum": ["zwingend", "freiwillig", "nach_hr_eintrag"] },
          "hinweis": { "type": "string" }
        }
      }
    }
  }
}
